#
# Checked-in local development defaults. Private credentials and personal
# overrides belong in .env.local or config/env/local.env, both ignored by git.

OSACA_ENV=development
NODE_ENV=development
OSACA_BASE_DOMAIN=localhost
OSACA_PUBLIC_SCHEME=http
OSACA_PUBLIC_PORT=8088
OSACA_STATIC_CDN_DOMAIN=localhost
OSACA_PUBLIC_URL=http://localhost:8088
OSACA_API_ENDPOINT=http://localhost:8088/api
OSACA_API_CLIENT_ENDPOINT=http://localhost:8088/api
OSACA_APP_ENDPOINT=http://localhost:8088
OSACA_GATEWAY_ENDPOINT=ws://localhost:8088/gateway
OSACA_MEDIA_ENDPOINT=http://localhost:8088/media
OSACA_STATIC_CDN_ENDPOINT=http://localhost:8088
OSACA_ADMIN_ENDPOINT=http://localhost:8088/admin
OSACA_MARKETING_ENDPOINT=https://osaca.example
OSACA_TRUST_CLIENT_IP_HEADER=true
OSACA_CLIENT_IP_HEADER_NAME=x-forwarded-for

OSACA_DATABASE_BACKEND=postgres
OSACA_POSTGRES_HOST=postgres
OSACA_POSTGRES_PORT=5432
OSACA_POSTGRES_DATABASE=osaca
