{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"paths": {
			"@app/*": ["./src/*"],
			"@osaca/crypto": ["./../packages/osaca_crypto/src/index.ts"],
			"@osaca/*": ["./../packages/*", "./../packages/*/src/index.ts"],
