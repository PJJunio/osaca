{
	"name": "osaca_desktop",
	"version": "0.0.0",
	"description": "Instant messaging and VoIP application",
	"homepage": "https://osaca.example",
	"author": "Fluxer Platform AB <support@osaca.example>",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"main": "dist/main/index.js",
	"scripts": {
		"build": "node scripts/build.mjs",
		"generate:windows-badges": "electron scripts/generate-windows-badges.mjs",
		"set-channel": "../tools/ci/run.sh build-desktop --step set_build_channel",
		"typecheck": "pnpm set-channel && tsc --noEmit"
	},
	"dependencies": {
		"@osaca/constants": "workspace:*",
		"@osaca/desktop_ipc": "workspace:*",
		"@osaca/instance_bootstrap": "workspace:*",
		"@osaca/ip_utils": "workspace:*",
		"@osaca/record_utils": "workspace:*",
		"@osaca/voice_engine_v2": "workspace:*",
		"@simplewebauthn/browser": "catalog:",
		"franc-min": "6.2.0",
		"hunspell-asm": "4.0.2",
		"undici": "catalog:",
		"velopack": "1.2.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"electron": "44.10.0",
		"electron-builder": "27.0.0-alpha.8",
		"esbuild": "catalog:",
		"typescript": "catalog:ts7"
	},
	"knip": {
		"ignoreDependencies": [
			"electron-builder"
		]
	},
	"optionalDependencies": {
		"@osaca/app-store": "file:./native/app-store",
		"@osaca/gateway-socket": "file:./native/gateway-socket",
		"@osaca/hardware-encoder": "file:./native/hardware-encoder",
		"@osaca/linux-audio-capture": "file:./native/linux-audio-capture",
		"@osaca/linux-evdev": "file:./native/linux-evdev",
		"@osaca/linux-input-hook": "file:./native/linux-input-hook",
		"@osaca/linux-notifications": "file:./native/linux-notifications",
		"@osaca/linux-portals": "file:./native/linux-portals",
		"@osaca/mac-app-audio": "file:./native/mac-app-audio",
		"@osaca/mac-clipboard": "file:./native/mac-clipboard",
		"@osaca/mac-screen-capture": "file:./native/mac-screen-capture",
		"@osaca/mac-sysctl": "file:./native/mac-sysctl",
		"@osaca/mac-tcc": "file:./native/mac-tcc",
		"@osaca/macos-input-hook": "file:./native/macos-input-hook",
		"@osaca/platform-info": "file:./native/platform-info",
		"@osaca/system-hunspell": "file:./native/system-hunspell",
		"@osaca/webauthn": "file:./native/webauthn",
		"@osaca/win-clipboard": "file:./native/win-clipboard",
		"@osaca/win-game-capture": "file:./native/win-game-capture",
		"@osaca/win-process-loopback": "file:./native/win-process-loopback",
		"@osaca/win-shell": "file:./native/win-shell",
		"@osaca/windows-input-hook": "file:./native/windows-input-hook",
		"electron-log": "5.4.4"
	}
}
