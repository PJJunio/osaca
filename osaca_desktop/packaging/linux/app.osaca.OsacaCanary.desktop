# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=OSACA Canary
GenericName=Instant Messenger
Comment=Canary build of OSACA
Exec=app.osaca.OsacaCanary %U
TryExec=app.osaca.OsacaCanary
Icon=app.osaca.OsacaCanary
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.osaca.OsacaCanary
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/osaca;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.osaca.OsacaCanary --osaca-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.osaca.OsacaCanary --osaca-task=new-dm %U
