{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noPropertyAccessFromIndexSignature": false,
		"jsx": "react-jsx",
		"paths": {
			"@electron/*": ["./src/*"],
			"@osaca/voice_engine_v2/*": ["../packages/voice_engine_v2/*"],
			"@osaca/account-engine-core": ["../packages/desktop_ipc/src/AccountEngineCoreModule.d.ts"],
			"@osaca/*": ["../packages/*", "../packages/*/src/index.ts"]
		}
	},
	"include": ["src/**/*", "../packages/desktop_ipc/src/**/*", "../packages/voice_engine_v2/src/**/*"],
	"exclude": ["node_modules", "dist"]
}
