# SPDX-License-Identifier: AGPL-3.0-or-later
-name ${OSACA_ERLANG_NODE_NAME}
-setcookie ${OSACA_ERLANG_COOKIE}
+A1
+P 262144
+Q 65536
+S ${OSACA_ERLANG_SCHEDULERS:-2}:${OSACA_ERLANG_SCHEDULERS:-2}
+SDcpu ${OSACA_ERLANG_DIRTY_CPU_SCHEDULERS:-1}:${OSACA_ERLANG_DIRTY_CPU_SCHEDULERS:-1}
+SDio ${OSACA_ERLANG_DIRTY_IO_SCHEDULERS:-2}
+sbwt none
+sbwtdcpu none
+sbwtdio none
+zdbbl 32768
+MBacul 0
+MBramv true
+MHas ageffcbf
+MBas ageffcbf
+MEas ageffcbf
+MHlmbcs 512
+MBlmbcs 512
+MElmbcs 512
-kernel logger_level warning
-kernel inet_dist_listen_min ${OSACA_ERLANG_DIST_PORT}
-kernel inet_dist_listen_max ${OSACA_ERLANG_DIST_PORT}
